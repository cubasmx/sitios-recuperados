nherit;\r\n    }\r\n\r\n    .legend-building-module button:hover,\r\n    .legend-building-module button:focus,\r\n    .legend-building-module button:focus-visible,\r\n    .legend-building-module button:active {\r\n      box-shadow: none !important;\r\n      outline: none !important;\r\n    }\r\n\r\n    .legend-building-module button:focus,\r\n    .legend-building-module button:focus-visible,\r\n    .legend-building-module a:focus,\r\n    .legend-building-module a:focus-visible {\r\n      box-shadow: none !important;\r\n      outline: none !important;\r\n    }\r\n\r\n    .legend-building__shell {\r\n      align-items: start;\r\n      display: grid;\r\n      gap: clamp(28px, 5vw, 70px);\r\n      grid-template-columns: minmax(250px, 0.72fr) minmax(520px, 1.4fr);\r\n      margin: 0 auto;\r\n      max-width: 1380px;\r\n      order: 1;\r\n    }\r\n\r\n    .legend-building__copy {\r\n      max-width: 470px;\r\n    }\r\n\r\n    .legend-building__eyebrow {\r\n      color: var(--legend-gold);\r\n      display: block;\r\n      font-size: 12px;\r\n      font-weight: 700;\r\n      letter-spacing: 0.16em;\r\n      margin-bottom: 18px;\r\n      text-transform: uppercase;\r\n    }\r\n\r\n    .legend-building__title {\r\n      color: var(--legend-text);\r\n      font-size: 32px;\r\n      font-weight: 500;\r\n      letter-spacing: 0;\r\n      line-height: 0.95;\r\n      margin: 0 0 22px;\r\n      text-transform: uppercase;\r\n    }\r\n\r\n    .legend-building__intro {\r\n      color: var(--legend-muted);\r\n      font-size: clamp(15px, 1.35vw, 18px);\r\n      line-height: 1.65;\r\n      margin: 0;\r\n    }\r\n\r\n    .legend-building__hint {\r\n      align-items: start;\r\n      border-left: 1px solid rgba(123, 63, 49, 0.24);\r\n      color: var(--legend-muted);\r\n      display: flex;\r\n      gap: 12px;\r\n      margin-top: 30px;\r\n      padding-left: 18px;\r\n    }\r\n\r\n    .legend-building__hint-dot {\r\n      background: var(--legend-gold);\r\n      border-radius: 999px;\r\n 